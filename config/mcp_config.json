{
  "$schema": "./mcp_config.schema.json",
  "version": 1,
  "description": "JARVIS v7.0 MCP server registry. The router loads enabled entries, imports each module, and calls its get_server() factory.",
  "defaults": {
    "request_timeout_s": 30
  },
  "servers": [
    {
      "name": "filesystem",
      "enabled": true,
      "module": "mcp.filesystem_mcp",
      "description": "Safe read/write filesystem access bounded by JARVIS_FS_ALLOWED_ROOTS.",
      "env_passthrough": [
        "HOME",
        "JARVIS_FS_ALLOWED_ROOTS",
        "JARVIS_FS_MAX_BYTES",
        "JARVIS_ZONE",
        "JARVIS_LAB_MODE"
      ],
      "tools": [
        "read_file",
        "write_file",
        "list_dir",
        "stat",
        "delete"
      ],
      "requires_snapshot_for": [
        "write_file",
        "delete"
      ]
    },
    {
      "name": "network",
      "enabled": true,
      "module": "mcp.network_mcp",
      "description": "HTTP(S), DNS, ping, TCP port check, and nmap (lab mode only).",
      "env_passthrough": [
        "JARVIS_NET_ALLOWLIST",
        "JARVIS_NET_ALLOW_PRIVATE",
        "JARVIS_NET_MAX_BODY",
        "JARVIS_LAB_MODE",
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "NO_PROXY"
      ],
      "tools": [
        "http_get",
        "http_post",
        "ping",
        "resolve",
        "port_check",
        "nmap_scan"
      ],
      "lab_only_tools": [
        "nmap_scan"
      ]
    },
    {
      "name": "automation",
      "enabled": true,
      "module": "mcp.automation_mcp",
      "description": "External automation: n8n webhook triggers + Apify actor runs.",
      "env_passthrough": [
        "N8N_WEBHOOK_BASE",
        "N8N_AUTH_HEADER",
        "APIFY_TOKEN",
        "APIFY_BASE"
      ],
      "tools": [
        "n8n_trigger",
        "apify_run_actor",
        "apify_get_dataset"
      ]
    },
    {
      "name": "n8n",
      "enabled": true,
      "module": "mcp.n8n_mcp",
      "description": "n8n workflow automation: create, list, get, update, delete, activate/deactivate, and execute workflows; list and retrieve executions.",
      "env_passthrough": [
        "N8N_BASE_URL",
        "N8N_API_KEY"
      ],
      "tools": [
        "n8n_list_workflows",
        "n8n_get_workflow",
        "n8n_create_workflow",
        "n8n_update_workflow",
        "n8n_delete_workflow",
        "n8n_activate_workflow",
        "n8n_execute_workflow",
        "n8n_list_executions",
        "n8n_get_execution"
      ]
    }
  ]
}