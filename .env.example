# ─── JARVIS Configuration ─────────────────────────────────────────────────────
# Copy to .env and fill in your values.
# JARVIS v7.0 routes exclusively to Anthropic Claude. ANTHROPIC_API_KEY is
# required; TELEGRAM_BOT_TOKEN is optional but recommended.

# ─── System ───────────────────────────────────────────────────────────────────
JARVIS_HOME=/home/jarvis
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8080
JARVIS_DASHBOARD_PORT=8081
JARVIS_DOMAIN=jarvis.yourdomain.com   # Required for HTTPS
USER_TIMEZONE=Europe/Athens

# Security zones: standard | lab | red
JARVIS_ZONE=standard
JARVIS_LAB_MODE=false    # Set true ONLY in isolated lab environments

# ─── LLM (Anthropic Claude — required) ────────────────────────────────────────
# Get a key at https://console.anthropic.com — v7 routes all model calls here.
ANTHROPIC_API_KEY=sk-ant-...

# ─── FREE STT (faster-whisper — runs locally) ─────────────────────────────────
STT_PROVIDER=whisper                # whisper | deepgram
WHISPER_MODEL=base                  # tiny | base | small | medium | large-v3
WHISPER_DEVICE=cpu                  # cpu | cuda
WHISPER_COMPUTE_TYPE=int8           # int8 | float16
WHISPER_LANGUAGE=el                 # el | en | auto

# ─── FREE TTS (edge-tts — Microsoft online, no key) ───────────────────────────
TTS_PROVIDER=edge                   # edge | kokoro | elevenlabs
EDGE_TTS_VOICE=el-GR-NestorasNeural # Greek male
# EDGE_TTS_VOICE=el-GR-AthinaNeural # Greek female
# KOKORO_VOICE=af_sarah              # If using Kokoro local TTS

# ─── FREE Embeddings (sentence-transformers — runs locally) ───────────────────
EMBED_PROVIDER=sentence-transformers
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBED_DIM=384

# ─── OPTIONAL: Telegram Bot (free, no API costs) ──────────────────────────────
# Get token from @BotFather, get your user ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# ─── OPTIONAL: KAIROS daemon ──────────────────────────────────────────────────
KAIROS_ENABLED=true
KAIROS_INTERVAL=300          # seconds between checks (default: 5 min)
KAIROS_GITHUB_REPOS=         # comma-separated: owner/repo,owner/repo2
DREAM_IDLE_THRESHOLD=900     # autoDream after N seconds idle (default: 15 min)

# ─── FREE CLOUD Embeddings (Jina AI — 1M tokens/month free) ──────────────────
# Get key at https://jina.ai — enables semantic memory search on Railway
# JINA_API_KEY=jina_...

# ─── OPTIONAL PAID: Deepgram STT (faster, 150-300ms vs 300-500ms) ────────────
# DEEPGRAM_API_KEY=...

# ─── OPTIONAL PAID: ElevenLabs TTS (75ms vs 100-200ms, higher quality) ───────
# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM  # Rachel

# ─── Budget controls (for paid APIs) ──────────────────────────────────────────
DAILY_TOKEN_BUDGET=500000    # Max tokens per day before throttling

# ─── Debug ────────────────────────────────────────────────────────────────────
JARVIS_DEBUG=false

# ═══════════════════════════════════════════════════════════════════════════════
#                          JARVIS v7.0 ADDITIONS
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Version & profile ────────────────────────────────────────────────────────
JARVIS_VERSION=7.0.0
JARVIS_PROFILE=standard           # standard | hardcore | lab

# ─── Hardcore mode (strict protocol enforcement) ──────────────────────────────
# Enables every P1–P7 protocol from CLAUDE.md without exceptions.
# Disables auto-confirm in yellow zone. Forces snapshot before every mutation.
JARVIS_HARDCORE=true
JARVIS_REQUIRE_SNAPSHOT=true      # refuse mutations without a git snapshot
JARVIS_FAIL_ON_SECRET=true        # refuse commit if secret pattern detected

# ─── Filesystem zones (override defaults from CLAUDE.md) ──────────────────────
# Comma-separated absolute paths. Empty = use CLAUDE.md defaults.
JARVIS_GREEN_PATHS=
JARVIS_YELLOW_PATHS=
JARVIS_RED_PATHS=
JARVIS_BLACK_PATHS=

# ─── Git snapshot retention ───────────────────────────────────────────────────
SNAPSHOT_RETENTION_DAYS=14        # prune pre-mutation/* tags older than N days
SNAPSHOT_MAX_COUNT=200            # absolute cap on snapshot tags

# ─── PostgreSQL (episodic + procedural memory) ────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jarvis
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=                # leave blank for peer auth
DATABASE_URL=                     # full URL overrides the fields above

# ─── pgvector (semantic memory) ───────────────────────────────────────────────
PGVECTOR_DIM=384                  # must match EMBED_DIM
PGVECTOR_INDEX=hnsw               # hnsw | ivfflat

# ─── MCP servers (Model Context Protocol) ─────────────────────────────────────
# Comma-separated list of MCP server names enabled at startup.
# Each name maps to mcp/<name>/config.json
MCP_ENABLED_SERVERS=filesystem,git,shell
MCP_SOCKET_DIR=/tmp/jarvis/mcp
MCP_REQUEST_TIMEOUT=30            # seconds per MCP call

# ─── n8n Automation (workflow engine) ─────────────────────────────────────────
# REQUIRED for workflow execution (n8n_execute_workflow, n8n_list_executions, n8n_get_execution)
# Get API key from n8n Settings → n8n API
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=your-n8n-api-key-here

# ─── Audit log ────────────────────────────────────────────────────────────────
AUDIT_LOG_PATH=~/.local/share/jarvis/audit.log
AUDIT_LOG_ROTATE_MB=50
AUDIT_LOG_KEEP=20                 # rotated files to retain

# ─── Skill scoring ────────────────────────────────────────────────────────────
SKILL_MIN_SCORE=70                # below this, append lesson to SKILL.md
SKILL_FAILURE_REVIEW_PCT=20       # flag skill for review at this failure rate
SKILL_FAILURE_WINDOW=20           # rolling window size for the percentage

# ─── Rate limits ──────────────────────────────────────────────────────────────
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_MS=500
LLM_RETRY_MAX_MS=8000

