# ─── JARVIS Configuration ─────────────────────────────────────────────────────
# Copy to .env and fill in your values.
# JARVIS v7.0 routes exclusively to Anthropic Claude. ANTHROPIC_API_KEY is
# required; TELEGRAM_BOT_TOKEN is optional but recommended.

# ─── System ───────────────────────────────────────────────────────────────────
JARVIS_HOME=/home/jarvis
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8080
JARVIS_DASHBOARD_PORT=8081
JARVIS_DOMAIN=jarvis.yourdomain.com   # Required for HTTPS
USER_TIMEZONE=Europe/Athens

# Security zones: standard | lab | red
JARVIS_ZONE=standard
JARVIS_LAB_MODE=false    # Set true ONLY in isolated lab environments

# ─── LLM (Anthropic Claude — required) ────────────────────────────────────────
# Get a key at https://console.anthropic.com — v7 routes all model calls here.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5     # Override model for cursor.py, fix_and_push.py
ANTHROPIC_BASE_URL=                   # Optional: proxy/gateway URL (e.g., https://api.neutralbeats.com)

# ─── FREE STT (faster-whisper — runs locally) ─────────────────────────────────
# Note: These variables are defined but not currently used in code
# STT_PROVIDER=whisper                # whisper | deepgram
# WHISPER_MODEL=base                  # tiny | base | small | medium | large-v3
# WHISPER_DEVICE=cpu                  # cpu | cuda
# WHISPER_COMPUTE_TYPE=int8           # int8 | float16
# WHISPER_LANGUAGE=el                 # el | en | auto

# ─── FREE TTS (edge-tts — Microsoft online, no key) ───────────────────────────
# Note: These variables are defined but not currently used in code
# TTS_PROVIDER=edge                   # edge | kokoro | elevenlabs
# EDGE_TTS_VOICE=el-GR-NestorasNeural # Greek male
# EDGE_TTS_VOICE=el-GR-AthinaNeural   # Greek female
# KOKORO_VOICE=af_sarah               # If using Kokoro local TTS

# ─── Embeddings ───────────────────────────────────────────────────────────────
JARVIS_EMBEDDING_PROVIDER=sentence-transformers  # sentence-transformers | ollama | openai | jina
JARVIS_EMBEDDING_MODEL=all-MiniLM-L6-v2          # Model name for embedding provider
JARVIS_EMBEDDING_DIM=384                         # Embedding dimension (must match model)
JINA_API_KEY=                                    # Jina AI API key (1M tokens/month free)
OPENAI_API_KEY=                                  # OpenAI API key for embeddings
OLLAMA_BASE_URL=http://localhost:11434           # Ollama server URL
OLLAMA_EMBED_MODEL=nomic-embed-text              # Ollama embedding model

# ─── OPTIONAL: Telegram Bot (free, no API costs) ──────────────────────────────
# Get token from @BotFather, get your user ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# ─── OPTIONAL: KAIROS daemon ──────────────────────────────────────────────────
KAIROS_ENABLED=true
KAIROS_INTERVAL=300          # seconds between checks (default: 5 min)
KAIROS_DRY_RUN=              # Set to enable dry-run mode (no actions)
KAIROS_GITHUB_TOKEN=         # GitHub token for repo monitoring

# ─── OPTIONAL PAID: Deepgram STT (faster, 150-300ms vs 300-500ms) ────────────
DEEPGRAM_API_KEY=

# ─── OPTIONAL PAID: ElevenLabs TTS (75ms vs 100-200ms, higher quality) ───────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM  # Rachel

# ═══════════════════════════════════════════════════════════════════════════════
#                          JARVIS v7.0 ADDITIONS
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Version & profile ────────────────────────────────────────────────────────
JARVIS_VERSION=7.0.0
JARVIS_AGENT_MODEL=claude-sonnet-4-5  # Model for agent loop (overrides DEFAULT_MODEL)
JARVIS_API_TIMEOUT=300.0              # API request timeout in seconds
JARVIS_ANTHROPIC_CRED_NAME=anthropic_api_key  # Credential name in systemd credentials
CREDENTIALS_DIRECTORY=                # Systemd credentials directory path
JARVIS_AGENT_STDERR_TRACE=            # Set to enable stderr trace logging

# ─── Hardcore mode (strict protocol enforcement) ──────────────────────────────
# Enables every P1–P7 protocol from CLAUDE.md without exceptions.
# Disables auto-confirm in yellow zone. Forces snapshot before every mutation.
JARVIS_REQUIRE_SNAPSHOT=true      # refuse mutations without a git snapshot

# ─── PostgreSQL (episodic + procedural memory) ────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jarvis
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=                # leave blank for peer auth
DATABASE_URL=                     # full URL overrides the fields above
DB_POOL_MIN_SIZE=1                # Minimum connection pool size
DB_POOL_MAX_SIZE=10               # Maximum connection pool size
DB_COMMAND_TIMEOUT=30             # Database command timeout (seconds)

# ─── MCP servers (Model Context Protocol) ─────────────────────────────────────
# MCP server configuration is in config/mcp_config.json
MCP_REQUEST_TIMEOUT=30            # seconds per MCP call (overridden by n8n: 120s)
MCP_MAX_RESTARTS=2                # Max stdio bridge restart attempts
MCP_STARTUP_TIMEOUT=30            # Stdio bridge startup timeout (seconds)

# Filesystem MCP
JARVIS_FS_ALLOWED_ROOTS=          # Comma-separated allowed root paths
JARVIS_FS_MAX_BYTES=8388608       # Max file size in bytes (default: 8MB)

# Network MCP
JARVIS_NET_ALLOWLIST=             # Comma-separated allowed hosts/domains
JARVIS_NET_ALLOW_PRIVATE=false    # Allow private IP ranges
JARVIS_NET_MAX_BODY=524288        # Max response body size (default: 512KB)

# ─── n8n Automation (workflow engine) ─────────────────────────────────────────
# REQUIRED for workflow execution (n8n_list_executions, n8n_get_execution, n8n_list_workflows)
# Get API key from n8n Settings → n8n API
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=your-n8n-api-key-here
N8N_AUTH_HEADER=                  # Optional: Authorization header for n8n webhooks
N8N_WEBHOOK_BASE=http://localhost:5678/webhook  # n8n webhook base URL

# ─── Apify (web scraping/automation) ──────────────────────────────────────────
APIFY_TOKEN=                      # Apify API token
APIFY_BASE=https://api.apify.com/v2  # Apify API base URL

# ─── Observability ────────────────────────────────────────────────────────────
OBS_ENABLED=true                  # Enable observability dashboard
JARVIS_TRACE_KEEP=5               # Number of rotated trace files to keep
JARVIS_TRACE_ROTATE_BYTES=52428800  # Trace file rotation size (default: 50MB)
JARVIS_TRACE_STDERR=              # Set to enable stderr trace output
JARVIS_SCORE_W_DURATION_S=        # Weight for duration in scoring
JARVIS_SCORE_W_TOKENS=            # Weight for token usage in scoring
JARVIS_SCORE_W_EXCEPTION=         # Weight for exceptions in scoring
JARVIS_SCORE_W_TEST_FAIL=         # Weight for test failures in scoring
JARVIS_SCORE_W_BUDGET=            # Weight for budget usage in scoring
OTEL_EXPORTER_OTLP_ENDPOINT=      # OpenTelemetry collector endpoint
OTEL_SERVICE_NAME=jarvis          # Service name for OTEL
OTEL_CONSOLE=                     # Set to enable console exporter

# ─── Daemons ──────────────────────────────────────────────────────────────────
# Sentinel
SENTINEL_ENABLED=true             # Enable sentinel daemon
JARVIS_SENTINEL_DRY_RUN=          # Set to enable dry-run mode

# Telegram
TELEGRAM_ENABLED=true             # Enable Telegram bot
TELEGRAM_CHAT_ID=                 # Fallback for TELEGRAM_USER_ID
TELEGRAM_WEBHOOK_URL=             # Webhook URL for Telegram (alternative to polling)

# Voice
VOICE_ENABLED=true                # Enable voice pipeline
VOICE_WS_HOST=0.0.0.0             # Voice WebSocket host
VOICE_WS_PORT=8080                # Voice WebSocket port
VOICE_WS_MAX_CONN=64              # Max concurrent voice connections
VOICE_WS_IDLE_TIMEOUT_S=300       # Voice connection idle timeout

# ─── Cloud Platform Detection ─────────────────────────────────────────────────
PORT=                             # Port override (auto-detected on Railway/Render/Fly)
FLY_APP_NAME=                     # Fly.io app name (auto-set by platform)
RAILWAY_ENVIRONMENT=              # Railway environment (auto-set by platform)
RENDER=                           # Render platform flag (auto-set by platform)

# ─── LLM Router ───────────────────────────────────────────────────────────────
GROQ_API_KEY=                     # Groq API key for LLM routing

# ─── Development ──────────────────────────────────────────────────────────────
JARVIS_DEV_RELOAD=                # Set to enable auto-reload on code changes

